<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Verificar Triângulo</title>
</head>
<body>
  <h1>Verificação de Triângulo</h1>
  
  <form action="/verificar" method="POST">
    <label for="lado1">Lado 1:</label>
    <input type="number" step="any" name="lado1" required><br><br>

    <label for="lado2">Lado 2:</label>
    <input type="number" step="any" name="lado2" required><br><br>

    <label for="lado3">Lado 3:</label>
    <input type="number" step="any" name="lado3" required><br><br>

    <button type="submit">Verificar</button>
  </form>

  <% if (resultado) { %>
    <h2><%= resultado %></h2>
  <% } %>

</body>
</html>